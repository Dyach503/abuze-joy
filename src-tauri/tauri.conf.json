{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "AbuzeJoy",
  "version": "0.1.0",
  "identifier": "com.abuze-joy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Abuze Joy",
        "width": 900,
        "height": 650,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Abuze Joy",
    "shortDescription": "VPN Traffic Router with DPI Bypass",
    "longDescription": "Abuze Joy is a VPN traffic router with Zapret DPI bypass support. Route traffic through VPN selectively or use Zapret to bypass DPI restrictions.",
    "copyright": "Copyright (c) 2026 Abuze Joy"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
